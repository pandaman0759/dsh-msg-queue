{
  "name": "dsh-msg-queue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "临时消息队列：工作中突然想到的话先写进左侧折叠列表，合适的时机再一键发送到当前会话",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandaman0759/dsh-msg-queue.git"
  },
  "homepage": "https://github.com/pandaman0759/dsh-msg-queue#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "queue",
    "ui"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
